   <|"Data" -> "# Release notes *2.8.3*\nFri 12 Sep 2025 19:04:12\n\nRate \
your experience with the previous release. Your feedback is important for \
us\n\n<style >\n    .rating { \n      display: flex;\n      flex-direction: \
row-reverse;\n      justify-content: center;\n    }\n    .rating input {\n    \
  display: none;\n    }\n    .rating label {\n      font-size: 2rem;\n      \
color: #ccc;\n      cursor: pointer;\n      transition: color 0.2s;\n    }\n  \
  .rating input:checked ~ label,\n    .rating label:hover,\n    .rating \
label:hover ~ label {\n      color: rgb(248 113 113);\n    }\n    .feedback \
{\n      display: block;\n      width: 100%;\n      max-width: 400px;\n      \
margin: 1rem auto;\n      padding: 0.5rem;\n      font-size: 1rem;\n    }\n   \
 .submit-btn {\n      display: block;\n      margin: 0.5rem auto;\n      \
padding: 0.5rem 1rem;\n      font-size: 1rem;\n      cursor: pointer;\n    \
}</style><form onsubmit=\"return false\" class=\"flex flex-col\" \
id=\"rating-c\"><fieldset ><div class=\"rating\" id=\"rating-form\"><input \
type=\"radio\" id=\"star5\" name=\"rating\" value=\"5\"/><label \
for=\"star5\">\[FivePointedStar]</label><input type=\"radio\" id=\"star4\" \
name=\"rating\" value=\"4\"/><label \
for=\"star4\">\[FivePointedStar]</label><input type=\"radio\" id=\"star3\" \
name=\"rating\" value=\"3\"/><label \
for=\"star3\">\[FivePointedStar]</label><input type=\"radio\" id=\"star2\" \
name=\"rating\" value=\"2\"/><label \
for=\"star2\">\[FivePointedStar]</label><input type=\"radio\" id=\"star1\" \
name=\"rating\" value=\"1\"/><label \
for=\"star1\">\[FivePointedStar]</label></div></fieldset><input type=\"text\" \
id=\"feedback-form\" name=\"feedback\" style=\"width:20rem\" class=\"border-1 \
ml-auto mr-auto align-center rounded-lg text-sm text-gray-700 ring-0 text-sm \
py-1\" placeholder=\"one-line feedback...\" \
maxlength=\"100\"/></form>\n\nTell your thoughts, what you would like to see \
or anything else. The form will be sent automatically once you have \
finished.", "Display" -> "markdown", 
    "Hash" -> "b8145015-79c3-4424-824c-3ccc83caa452", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "0572c525-0bd8-462f-a519-7d7bc643835c"|>, 
   <|"Data" -> ".html\n<script type=\"module\">\n    const rating = [];\n    \
for (let i = 1; i <= 5; ++i) rating.push(document.getElementById(\"star\" + \
i));\n    const feedback = document.getElementById(\"feedback-form\");\n    \
const container = document.getElementById(\"rating-c\");\n\n    let rate = \
-1;\n    let text = \"undefined\";\n    let timer = false;\n    let disabled \
= false;\n\n    const submitForm = () => {\n      disabled = true;\n      let \
n = 1;\n      let interval = setInterval(() => {\n        \
container.style.filter = \"blur(\" + n + \"px)\";\n        n++;\n        if \
(n > 200) {\n          clearInterval(interval);\n        }\n          \n      \
}, 30);\n\n      server.io.fire('submit-form-281', [rate, text]);\n    }\n\n  \
  const setTimer = () => {\n      if (disabled) return;\n      if (timer) \
clearTimeout(timer);\n      timer = false;\n      timer = \
setTimeout(submitForm, 5000);\n    }\n\n    const clearTimer = () => {\n      \
if (timer) clearTimeout(timer);\n      timer = false;\n    }\n\n    \
rating.forEach((e) => {\n      e.addEventListener('change', (ev) => {\n       \
 rate = ev.srcElement.value;\n        setTimer();\n      });\n    });\n\n    \
feedback.addEventListener('input', () => {\n      text = feedback.value;\n    \
  clearTimer();\n    });\n\n    feedback.addEventListener('focus', () => {\n  \
    clearTimer();\n    });\n\n    feedback.addEventListener('blur', () => {\n \
     text = feedback.value;\n      setTimer();\n    })\n</script>", 
    "Display" -> "codemirror", "Hash" -> 
     "75102af6-d4ec-4e69-ba23-4c270953cdca", "Invisible" -> False, 
