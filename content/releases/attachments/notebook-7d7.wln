   <|"Data" -> "video = (* import a video *)\nWith[{frames = \
VideoExtractFrames[video, {1,2}]},\n  HighlightImage[frames//First, {Yellow, \
ImageFeatureTrack[frames, MaxFeatures->25, Tolerance->0.01] // First}]\n]", 
    "Display" -> "codemirror", "Hash" -> 
