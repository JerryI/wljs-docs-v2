*)(*,*)(*\"1:eJxTTMoPSmNhYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCS4g4Zyfm5uaV+KUXxEM\
Uqxsbm6exgSSBPGCSnNSg9mAjOCSosy8dLBYSFFpKpoKkDkeqYkpEFXBILO1sCgJSczMQVYCAOFrJ\
EU=\"*)(*]BB*)\n        Do[\n           hy[[j]] += (*FB[*)(((ez[[j + 1]] - \
ez[[j]]))(*,*)/(*,*)(\[Zeta] \\[Mu]r[[j]]))(*]FB*);\n        , {j, 1, \
ie-1}];\n\n        (*BB[*)(*Boundary \
conditions*)(*,*)(*\"1:eJxTTMoPSmNhYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCS4g4Zyfm5\
uaV+KUXxEMUqxsbm6exgSSBPGCSnNSg9mAjOCSosy8dLBYSFFpKpoKkDkeqYkpEFXBILO1sCgJScz\
MQVYCAOFrJEU=\"*)(*]BB*)\n        hy[[ie]] = hy[[ie-1]];\n        ez[[ie]] = \
ez[[ie-1]];\n      \n        (*BB[*)(*Pulse \
generator*)(*,*)(*\"1:eJxTTMoPSmNhYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCS4g4Zyfm5u\
aV+KUXxEMUqxsbm6exgSSBPGCSnNSg9mAjOCSosy8dLBYSFFpKpoKkDkeqYkpEFXBILO1sCgJSczM\
QVYCAOFrJEU=\"*)(*]BB*)\n        hy[[49]] -= Exp[- (*FB[*)(((*SpB[*)Power[(n \
- 30.)(*|*),(*|*)2](*]SpB*))(*,*)/(*,*)(100.))(*]FB*)] \
(*FB[*)((1)(*,*)/(*,*)(\[Zeta] \\[Mu]r[[49]]))(*]FB*);\n\n        ez[[1]] = \
ez[[2]];\n\n        (*BB[*)(*Calculate electric field \
*)(*,*)(*\"1:eJxTTMoPSmNhYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCS4g4Zyfm5uaV+KUXxEM\
Uqxsbm6exgSSBPGCSnNSg9mAjOCSosy8dLBYSFFpKpoKkDkeqYkpEFXBILO1sCgJSczMQVYCAOFrJ\
EU=\"*)(*]BB*)\n        Do[\n          ez[[j]] = ez[[j]] + \
(*FB[*)((\[Zeta])(*,*)/(*,*)(\\[Epsilon]r[[j]]))(*]FB*) (hy[[j]] - hy[[j - \
1]])\n        , {j, 2, ie - 1}];\n\n        (*BB[*)(*Pulse \
generator*)(*,*)(*\"1:eJxTTMoPSmNhYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCS4g4Zyfm5u\
aV+KUXxEMUqxsbm6exgSSBPGCSnNSg9mAjOCSosy8dLBYSFFpKpoKkDkeqYkpEFXBILO1sCgJSczM\
QVYCAOFrJEU=\"*)(*]BB*)\n        ez[[50]] += Exp[- (*FB[*)(((*SpB[*)Power[(n \
+ 0.5 - (-0.5) - 30.)(*|*),(*|*)2](*]SpB*))(*,*)/(*,*)(100.0))(*]FB*)];\n\n   \
     \n        \n      , {n, steps}]; ez],\n    CompilationOptions -> \
{\"InlineExternalDefinitions\" -> True}, \n    \"CompilationTarget\" -> \
\"C\", \"RuntimeOptions\" -> \"Speed\"]];", "Display" -> "codemirror", 
