     ".md\nAnd here is a little helper function for drawing all bonds:", 
    "Display" -> "codemirror", "Hash" -> 
     "5e9b73f2-1cd0-4314-883b-0e01ee7b4ea6", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> "And here is a little helper function for drawing all bonds:", 
    "Display" -> "markdown", "Hash" -> 
     "f8eadbb9-dfbd-4d90-b36f-310bcbcab406", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> "drawBonds[context_, vert_, edges_] := Module[{},\n\n  \
ctx`ClearRect[context, {0,0}, {500,500}];\n\n  ctx`BeginPath[context];\n  \
ctx`SetLineWidth[context, 4];\n  ctx`SetStrokeStyle[context, \
(*VB[*)(RGBColor[0.4, 0.6, \
0.9])(*,*)(*\"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3c\
s7PyS8qmjUTBG7aFxmDwWP7orNnQOCNPQBuvhsO\"*)(*]VB*)];\n\n  Do[\n    \
ctx`MoveTo[context, {0, 500} - {-5, 5} vert[[p[[1]]]]];\n    \
ctx`LineTo[context, {0, 500} - {-5, 5} vert[[p[[2]]]]];\n  , {p, edges}];\n\n \
 ctx`Stroke[context];\n\n  ctx`SetFillStyle[context, (*VB[*)(RGBColor[0.4, \
0.9, \
0.6])(*,*)(*\"1:eJxTTMoPSmNiYGAo5gUSYZmp5S6pyflFiSX5RcEsQBHn4PCQNGaQPAeQCHJ3c\
s7PyS8qmjUTBG7aF509AwJv7IuMweCxPQCPXhsO\"*)(*]VB*)];\n\n  (\n    \
ctx`BeginPath[context];\n    ctx`Arc[context, {0, 500} - {-5, 5} #, 6, 0, 2.0 \
Pi];\n    ctx`Fill[context];\n  ) &/@ vert;\n\n  ctx`Dispatch[context];\n];", 
    "Display" -> "codemirror", "Hash" -> 
     "256d9507-cfbf-49ce-934e-125de8c51683", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Fade" -> True, "InitGroup" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> ".md\n### Simulation\nAnd now finally the simulation!", 
    "Display" -> "codemirror", "Hash" -> 
     "1dab07a6-0f7a-4308-af4c-016417841f48", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> "### Simulation\nAnd now finally the simulation!", 
    "Display" -> "markdown", "Hash" -> 
     "e0afc9ee-1237-433f-8cd0-13d70d4c6646", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> "generatorSimulation[finalVerts_, finalBonds_] := Module[{\n  \
coords, coords3, coords2\n},\n\ncoords = finalVerts;\ncoords2 = \
finalVerts;\ncoords3 = finalVerts;\n\nFunction[Null, Do[\n    coords3 = \
coords2;\n    coords2 = coords;\n    \n    Module[{new = 2 coords2 - coords3 \
+ Table[{0,-1}, Length[coords]] 0.0001},\n      MapThread[Function[{i,j,l}, \
With[{d = new[[i]]-new[[j]]}, With[{m = \
Min[((*FB[*)((l)(*,*)/(*,*)(Norm[d]+0.001))(*]FB*) - 1), 0.1]},\n        \
new[[i]] +=  (*FB[*)((1)(*,*)/(*,*)(2))(*]FB*) m d;\n        new[[j]] -=  \
(*FB[*)((1)(*,*)/(*,*)(2))(*]FB*) m d;\n      ] ]], \
RandomSample[finalBonds]// Transpose]; \n      \n      new = \
Map[Function[xy,\n        If[xy[[2]] < 0.0, {xy[[1]], 0.0}, xy]\n      ], \
new];\n      \n      coords = new;\n    ];\n\n    , {2 5}];\n\n    \
coords\n]]", "Display" -> "codemirror", 
    "Hash" -> "cea80101-26b2-45c3-932f-3d688a5977e9", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"InitGroup" -> True, "Fade" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> ".md\nRun it in a loop:", "Display" -> "codemirror", 
    "Hash" -> "6356ac0a-87b3-48cb-96f5-7fa3b643e89f", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> "Run it in a loop:", "Display" -> "markdown", 
    "Hash" -> "c83a2a8a-2367-4aad-b154-172e6f1ec2f8", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "b1000fb1-c9cc-423c-925a-13fafc2266f2"|>, 
   <|"Data" -> "{finalVerts, finalPairs} = \
NotebookRead@NotebookStore[\"dudeMesh\"];\nfinalBonds = {finalPairs[[All,1]], \
finalPairs[[All,2]], Norm[finalVerts[[#[[1]]]] - \
finalVerts[[#[[2]]]]]&/@finalPairs} // Transpose;\n\nWith[{\n  context2D = \
ctx`Canvas2D[],\n  uid = CreateUUID[],\n  calc = generatorSimulation[{#[[1]], \
#[[2]] + 50.0} &/@ finalVerts, finalBonds]\n},\n  EventHandler[uid, \
Function[Null,\n    drawBonds[context2D, calc[], finalPairs]\n  ]];\n  \
Image[context2D, ImageResolution->{500,500}, Epilog->{\n    \
AnimationFrameListener[context2D, \"Event\"->uid]\n  }]\n]", 
    "Display" -> "codemirror", "Hash" -> 
     "c50df029-9947-48f7-a628-1af2de9b1a75", "Invisible" -> False, 
