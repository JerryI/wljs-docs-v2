ts/Cascadia.woff2\");\n      }\n      @font-face {\n        font-family: \
\"Assistant\";\n        src: \
url(\"https://unpkg.com/@excalidraw/excalidraw@undefined/dist/excalidraw-asse\
ts/Assistant-Regular.woff2\");\n      }\n    </style>\n    \n  </defs>\n  <g \
