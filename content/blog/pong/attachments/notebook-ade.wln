.md
### Our finished game
It is time to playtest.

__Timecode: 2:18:03__

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
### Our finished game
It is time to playtest.

__Timecode: 2:18:03__

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
paddles = {{-0.75,0.}, {0.75,0.}};
prevPaddles = paddles;
score = {0,0};
playerTarget = 0.5;

$paddles = 2{0.02, 0.21};
$ballRadius = 0.03;
$initVel = 0.03;

\[Eta] = 0.5;  (* momentum transfer paddle->ball coeff.*)
\[Alpha] = 0.15; (* 1/sloppines of 2nd player *)
\[Beta] = 0.6;  (* paddle movement smoothing *)

(* Main animation loop *)
handler[_] := With[{},
  (* player's paddle position interpolation *)
  (* mousemove fires events every ~10-50 ms only *)
  prevPaddles = paddles;
  paddles[[1,2]] = (1 - \[Beta]) paddles[[1,2]] + \[Beta] playerTarget;

  (* if ball hit left/right wall *)
  If[Abs[ball[[2,1]]] >= 1, 
    score = score + If[ball[[2,1]] > 0, 
      {1,0}, {0,1}
    ];

    (* reset game *)
    ball[[1]] = 0.0 ball[[1]];
    ball[[2]] = 0.0 ball[[2]];
    ball[[1]] = $initVel 
      RandomChoice[{-1,1}] 
      AngleVector[RandomReal[{-1,1} Pi/3.0]];
      
    SFXLost // EmitSound;
  ];

  (* top/bottom - just reflection *)
  If[Abs[ball[[2,2]]] >= 1, 
    ball[[{1,2}, 2]] = ball[[{2,1}, 2]];
  ]; 

  (* collisions with 2 paddles *)
  Do[
    (* here we consider only left/right surfaces *)
    If[
      Abs[ball[[2,1]] - paddles[[i,1]]] < $ballRadius + $paddles[[1]]/2 &&
      Abs[ball[[2,2]] - paddles[[i,2]]] < $ballRadius + $paddles[[2]]/2,
        (* reflect x-velocity *)
        ball[[{1,2}, 1]] = ball[[{2,1}, 1]];
        (* transfer momentum to y-velocity from the paddle *)
        (* 1:43:44 Momentum transfer *)
        ball[[1,2]] -= \[Eta] (paddles[[1,2]]-prevPaddles[[1,2]]);
        
        SFXPaddle // EmitSound;
        Break[];
    ],
  {i, 2}];

  (* solve kinematic equations *)
  ball = integrate[ball, {0.,0.}, 0.1];

  (* CPU paddle aka 2nd player is just P controller *)
  paddles[[2,2]] = (1-\[Alpha]) paddles[[2,2]] + \[Alpha] ball[[2,2]];
  (* trigger sync with frontend *)
  paddles = paddles;
];

EventHandler[Graphics[{
  {Pink, 
    Opacity[0.3], (* sick trail *)
    Disk[ball[[1]] // Offload, $ballRadius],
    Opacity[1.0],
    Disk[ball[[2]] // Offload, $ballRadius]
  },
  Black, 
  Translate[Rectangle[
    -$paddles/2,$paddles/2, RoundingRadius->0.02
  ], paddles[[1]]//Offload],
  Translate[Rectangle[
    -$paddles/2,$paddles/2, RoundingRadius->0.02
  ], paddles[[2]]//Offload],
  Dashed, Line[{{0.0, -0.75}, {0.0,0.75}}],

  Black,
  Directive[FontSize->18, FontFamily->"monospace"],
  Text[score[[1]]//ToString//Offload, {-0.5,0.75}, {0,0}],
  Text[score[[2]]//ToString//Offload, {0.5,0.75}, {0,0}],
  
  EventHandler[
    AnimationFrameListener[ball//Offload],
    handler
  ]
}, AspectRatio->1, ImageSize->350, 
  PlotRange->1, "TransitionType"->None], {
  "mousemove" -> Function[xy,
    playerTarget = xy[[2]];
  ]
}]//Framed 

