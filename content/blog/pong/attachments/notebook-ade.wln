%-------------------------------------------------------------------------%
ball = 0.0 ball;
ball[[2]] = {-0.01,-0.02};

Do[
  If[Abs[ball[[2,1]]] >= 1, 
    ball[[{1,2}, 1]] = ball[[{2,1}, 1]];
  ];

  If[Abs[ball[[2,2]]] >= 1, 
    ball[[{1,2}, 2]] = ball[[{2,1}, 2]];
  ];  
  
  ball = integrate[ball, {0.,0.}, 0.1];
  Pause[1/60.0];
, {300}];

