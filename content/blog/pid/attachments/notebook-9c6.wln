   <|"Data" -> "{\n  v'[t] == u[t]/m,\n  x'[t] == v[t],\n  e[t] == (a - \
x[t])\n} /. {\n  v'[t] -> (*FB[*)((v[n] - \
v[n-1])(*,*)/(*,*)(\\[Delta]t))(*]FB*),\n  v[t] -> v[n],\n  x'[t] -> \
(*FB[*)((x[n] - x[n-1])(*,*)/(*,*)(\\[Delta]t))(*]FB*),\n  x[t] -> x[n],\n  \
e[t] -> e[n]\n}//Simplify;\n\nSolve[%, {v[n], x[n], \
e[n]}]//Flatten//TableForm", "Display" -> "codemirror", 
    "Hash" -> "48504a3b-7744-46d2-8950-09e1c0731edb", "Invisible" -> False, 
