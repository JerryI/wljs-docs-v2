    "UID" -> Null, "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> 
     "Now what if we apply a constant acceleration to one of the sides:", 
    "Display" -> "markdown", "Hash" -> 
     "5a50a258-016c-4634-b18a-992b62088c5f", "Invisible" -> False, 
