   <|"Data" -> "system = {\n  (u')[t]==e[t] \
((*SbB[*)Subscript[K(*|*),(*|*)\"i\"](*]SbB*))+((*SbB[*)Subscript[K(*|*),(*|*\
)\"p\"](*]SbB*)) (e')[t]+((*SbB[*)Subscript[K(*|*),(*|*)\"d\"](*]SbB*)) \
(e'')[t],\n  u[0] == ((*SbB[*)Subscript[K(*|*),(*|*)\"p\"](*]SbB*)) (a - \
x[0]),\n  x''[t] == u[t]/m + 1.0,\n  x'[0] == 0.,\n  x[0] == 0.,\n\n  e[t] == \
(a - x[t])\n};\n\nClearAll[sol];\nsol[p_, i_, d_] := Flatten@NDSolve[system \
