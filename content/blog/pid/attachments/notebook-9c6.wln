   <|"Data" -> ".mermaid\nflowchart LR\n    \n    R2[\"Mouse\"] --> \
C2[\"P\"]\n    A[\"Pendulum angle\"] --> C[\"PID\"]\n    C --> SUM((+))\n    \
SUM --> M[\"Motor voltage\"]\n    M --> Position\n    Position --> C2\n    M \
--> A\n    C2 --> SUM", "Display" -> "codemirror", 
    "Hash" -> "49db1ead-1137-4f9b-98f2-1f7af18e51be", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> "flowchart LR\n    \n    R2[\"Mouse\"] --> C2[\"P\"]\n    \
A[\"Pendulum angle\"] --> C[\"PID\"]\n    C --> SUM((+))\n    SUM --> \
M[\"Motor voltage\"]\n    M --> Position\n    Position --> C2\n    M --> A\n  \
  C2 --> SUM", "Display" -> "mermaid", 
    "Hash" -> "a5e6493e-601a-4439-938b-cba4f5c09556", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> ".md\nHere is our assembled code:", "Display" -> "codemirror", 
    "Hash" -> "ae6b5e5c-48fa-4c83-87e0-37ec14b007e7", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> "Here is our assembled code:", "Display" -> "markdown", 
    "Hash" -> "a71a5afc-16c1-433f-b764-dcd607cf4cea", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> "Module[{p = <|\"P\" -> 11.71, \"I\" -> 36.56, \"D\" -> 0|>}, \
Module[{\n  platform = createPlatform[0.0, 1.0],\n  pid = createPID,\n  pid2 \
= createPID,\n  pen = createPendulum[0.01, 9., 1.0, 0.03],\n  x = .0,\n  ac = \
.0,\n  \n  target = 0.0,\n  voltage = .0,\n  pos = {0., 0.},\n  angle = \
0.0,\n  history = Table[{i,0.}, {i,300}],\n  handler\n},\n\n  handler = \
Function[Null,\n    \n    voltage = Clip[pid[angle, p[\"P\"], p[\"I\"], \
p[\"D\"], 2 0.02], {-15,15}];\n    voltage = Clip[pid[angle, p[\"P\"], \
p[\"I\"], p[\"D\"], 2 0.02], {-15,15}];\n    {x, ac} = platform[ voltage + \
2.0 (x-target), 2 0.02];\n    angle = pen[-ac, 2 0.02];\n    {x, ac} = \
platform[ voltage + 2.0 (x-target), 2 0.02];\n    angle = pen[-ac, 2 0.02];\n \
   pos = {Sin[angle], Cos[angle]};\n    history[[1,2]] = voltage;\n    \
history = Transpose[{history[[All,1]], RotateLeft[history[[All,2]]]}];\n  \
];\n  \n  Row[{EventHandler[Graphics[{\n    Translate[{{Brown, \
Disk[{0,-0.8+1.0}, 0.1]},\n      Rectangle[{-0.4,-1.0+0.2+1.0}, \
{0.4,-1.0+0.4+1.0}],\n      Red, Line[{{0,0.4}, pos// Offload}], Disk[pos// \
Offload, 0.05]\n    }, {x,-0.1 - 1.0} // Offload],\n    Line[{{-2.0, -1.0}, \
{2, -1.0}}],\n    EventHandler[AnimationFrameListener[pos//Offload], \
handler],\n    Green, Arrow[{{target, -1.2}, {target, -1.0}} // Offload]\n  \
}, \n    \"TransitionType\"->None,\n    PlotRange->{{-2,2}, {-1- 0.2,1- \
0.2}}, ImageSize->{400,200}], {\n    \"mousemove\" -> Function[xy, \n      \
target = 0.6 target + 0.4 xy[[1]]\n    ]\n  }],\n  \n  Graphics[Line[history \
// Offload], PlotRange->{{1,300}, {-2,2}}, ImageSize->{200,300}, Axes->True, \
AxesOrigin->{0,0.00001}, Ticks->{False, True}, \"TransitionType\"->None, \
Frame->True, PlotLabel->\"Voltage\"],\n    Column[{Button[\"Reset\", \n      \
platform = createPlatform[0.0, 1.0];\n      pid = createPID;\n      pen = \
createPendulum[0.01, 9., 1.0, 0.03];\n      ac = .0;\n      voltage = .0;\n   \
   angle = 0.0;\n    \n    ], EventHandler[InputGroup[<|\n      \"P\" -> \
InputRange[0, 40.0, 0.01, p[\"P\"], \"Label\"->\"P\"],\n      \"I\" -> \
InputRange[0, 40.0, 0.01, p[\"I\"], \"Label\"->\"I\"],\n      \"D\" -> \
InputRange[0, 10.0, 0.01, p[\"D\"], \"Label\"->\"D\"]\n    |>], \
Function[data, p = data]]}]\n  }]\n] ]", "Display" -> "codemirror", 
    "Hash" -> "dc4b89eb-bf35-4db7-9aee-b918eaac7189", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Input", "UID" -> Null, 
    "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> ".md\nAs one can see here, **I** and **P** are the most \
crucial. Our system is highly non-linear, since the pendulum motion is \
translated into angular motion, and then only to linear motion driven by a \
motor. In this sense, this system is quite different from the heater or block \
of mass on a rail we investigated earlier.\n\nIt would be great to test one \
in real life.", "Display" -> "codemirror", 
    "Hash" -> "432edb52-861d-4e4d-afb4-2894ebd282be", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> "As one can see here, **I** and **P** are the most crucial. \
Our system is highly non-linear, since the pendulum motion is translated into \
angular motion, and then only to linear motion driven by a motor. In this \
sense, this system is quite different from the heater or block of mass on a \
rail we investigated earlier.\n\nIt would be great to test one in real life."\
, "Display" -> "markdown", "Hash" -> "ca0d4e80-8e23-46a1-9b9a-4871233a6793", 
    "Invisible" -> False, "MetaOnly" -> False, "Props" -> <||>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Output", 
    "UID" -> Null, "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>}, 
