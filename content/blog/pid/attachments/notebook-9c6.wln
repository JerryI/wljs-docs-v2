   <|"Data" -> "Let's go!", "Display" -> "markdown", 
    "Hash" -> "0c9f087e-abe0-4037-945f-a08658a76f97", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "9c673000-6b4c-436e-b4a6-d378d6d85afc"|>, 
   <|"Data" -> "pid = createPID;\nsys = testSystem[0., 1.0];\n\nModule[{\n  \
value = 0.0,\n  error = 0.0,\n  target = 0.5,\n  control = 0.0,\n  gravity = \
0.25,\n  history = Table[{i,0.}, {i,300}],\n  p = <|\"P\" -> 1.0, \"I\" -> \
0.0, \"D\" -> 0.0|>,\n  handler\n},\n  handler = Function[Null,\n    {value, \
error} = sys[Clip[pid[error, p[\"P\"], p[\"I\"], p[\"D\"], 0.1], {-10,10}] - \
gravity, target, 0.1];\n    history[[1,2]] = error;\n    history = \
Transpose[{history[[All,1]], RotateLeft[history[[All,2]]]}];\n  ];\n  \n \
Row[{EventHandler[Graphics[{\n    Red, Line[{{-1,target}, {1, target}}] // \
Offload,\n    Blue, Line[{{-1,value}, {1, value}}] // Offload,\n    \
EventHandler[AnimationFrameListener[value // Offload], handler]\n  }, \
PlotRange->{{-1,1}, {-1,1}}, ImageSize->{100,300}], {\"mousemove\" -> \
Function[xy,\n    target = Clip[xy[[2]], {-0.8,0.8}];\n  ]}],\n    \
Graphics[Line[history // Offload], PlotRange->{{1,300}, {-1,1}}, \
ImageSize->{200,300}, Axes->True, AxesOrigin->{0,0.00001}, Ticks->{False, \
True}, \"TransitionType\"->None, Frame->True, PlotLabel->\"Error\"],\n    \
EventHandler[InputGroup[<|\n      \"P\" -> InputRange[0, 2.0, 0.01, p[\"P\"], \
\"Label\"->\"P\"],\n      \"I\" -> InputRange[0, 2.0, 0.01, p[\"I\"], \
\"Label\"->\"I\"],\n      \"D\" -> InputRange[0, 2.0, 0.01, p[\"D\"], \
\"Label\"->\"D\"]\n    |>], Function[data, p = data]]\n  }]\n  \n]", 
    "Display" -> "codemirror", "Hash" -> 
     "0a7896be-ed46-45f9-b23e-3f7b17cf769f", "Invisible" -> False, 
