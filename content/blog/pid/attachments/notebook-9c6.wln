   <|"Data" -> "pen = createPendulum[0.01, 9.9, 1.0, 0.03];\nModule[{pos = \
{0,1.0}, t = 0.0}, Animate[\n  t = pen[30.0, 0.1];\n  pos = {Sin[t], \
Cos[t]};\n  Graphics[{{Red,Arrow[{{0,0}, {0.8,0}}]}, Line[{{0,0}, pos}], \
Disk[pos, 0.05]}, PlotRange->{{-1,1}, {-1,1}}, AxesOrigin->{0.00001,0}, \
