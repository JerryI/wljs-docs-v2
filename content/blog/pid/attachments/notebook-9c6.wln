   <|"Data" -> "createPID := Module[{uState, hState, eState}, With[{\n  \
rules1 = dsol,\n  rules2 = {\n    e[n-1] -> Indexed[eState, 2],\n    e[n] -> \
Indexed[eState, 1],\n\n    h[n-1] -> Indexed[hState, 2],\n    h[n] -> \
Indexed[hState, 1],\n\n    u[n-1] -> Indexed[uState, 2],\n    u[n] -> \
Indexed[uState, 1],\n\n    \\[Delta]t -> #5,\n    \
(*SbB[*)Subscript[K(*|*),(*|*)\"d\"](*]SbB*) -> #4,\n    \
(*SbB[*)Subscript[K(*|*),(*|*)\"p\"](*]SbB*) -> #2,\n    \
(*SbB[*)Subscript[K(*|*),(*|*)\"i\"](*]SbB*) -> #3\n  }\n},\n  \
Hold@Module[{},\n  \n    uState = {0,0}; \n    hState = {0,0};\n    eState = \
{0,0};\n    \n    (\n      eState[[2]] = eState[[1]];\n      eState[[1]] = \
#1;\n      \n      hState[[2]] = hState[[1]];\n      hState[[1]] = h[n];\n\n  \
    uState[[2]] = uState[[1]];\n      uState[[1]] = u[n]\n    )&\n  ] /. \
rules1 /. rules2  \n] ] // ReleaseHold;", "Display" -> "codemirror", 
