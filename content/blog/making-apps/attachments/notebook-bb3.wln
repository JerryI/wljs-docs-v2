nData = RandomReal[];
nText = ToString[NumberForm[nData, {3,2}]];
Row[{"\[Omega] = ", TextView[nText // Offload]}]

Do[nData = RandomReal[]; nText = ToString[NumberForm[nData, {3,2}]]; Pause[0.1], {10}]

