data = data.normal();\n  }\n\n  const x = env.xAxis;\n  const y = \
env.yAxis;\n\n  data = normalizePoints(data);\n\n  const size = env.pointSize \
* 200;\n  const exponent = 4;\n  const steps = 32;\n\n  const object = \
env.svg.append(\"g\")\n    .style(\"opacity\", env.opacity);\n\n  \
data.forEach((d) => {\n    const cx = x(d[0]);\n    const cy = y(d[1]);\n    \
const err = d[2];\n\n    if (typeof err === \"number\" && \
Number.isFinite(err)) {\n      const y1 = y(d[1] - err);\n      const y2 = \
y(d[1] + err);\n      const capWidth = Math.max(6, size * 0.35);\n\n      \
object.append(\"line\")\n        .attr(\"x1\", cx)\n        .attr(\"y1\", \
y1)\n        .attr(\"x2\", cx)\n        .attr(\"y2\", y2)\n        \
.style(\"stroke\", env.color)\n        .style(\"stroke-width\", 1.5)\n        \
.style(\"fill\", \"none\");\n\n      object.append(\"line\")\n        \
.attr(\"x1\", cx - capWidth / 2)\n        .attr(\"y1\", y1)\n        \
.attr(\"x2\", cx + capWidth / 2)\n        .attr(\"y2\", y1)\n        \
.style(\"stroke\", env.color)\n        .style(\"stroke-width\", 1.5)\n        \
.style(\"fill\", \"none\");\n\n      object.append(\"line\")\n        \
.attr(\"x1\", cx - capWidth / 2)\n        .attr(\"y1\", y2)\n        \
.attr(\"x2\", cx + capWidth / 2)\n        .attr(\"y2\", y2)\n        \
.style(\"stroke\", env.color)\n        .style(\"stroke-width\", 1.5)\n        \
.style(\"fill\", \"none\");\n    }\n\n    object.append(\"path\")\n      \
.attr(\"d\", squirclePath(cx, cy, size, exponent, steps))\n      \
.style(\"fill\", env.color);\n  });\n\n  return object;\n};", 
