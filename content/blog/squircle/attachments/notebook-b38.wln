data.forEach((d) => {\n    const cx = x(d[0]);\n    const cy = y(d[1]);\n\n   \
 object.append(\"path\")\n      .attr(\"d\", squirclePath(cx, cy, size, \
exponent, steps))\n      .style(\"fill\", env.color);\n  });\n\n  return \
object;\n};\n\ncore.SquircleErr = async (args, env) => {\n  let data = await \
