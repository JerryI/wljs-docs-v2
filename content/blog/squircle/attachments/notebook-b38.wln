   <|"Data" -> "function normalizePoints(data) {\n  if (!Array.isArray(data)) \
return [];\n  if (data.length === 0) return [];\n  if \
(!Array.isArray(data[0])) return [data];\n  return data;\n}\n\nfunction \
squirclePath(cx, cy, size, n = 4, steps = 32) {\n  const a = size / 2;\n  \
const b = size / 2;\n  const pts = [];\n\n  for (let i = 0; i < steps; i++) \
{\n    const t = (i / steps) * Math.PI * 2;\n    const ct = Math.cos(t);\n    \
const st = Math.sin(t);\n\n    const px = cx + a * Math.sign(ct) * \
Math.pow(Math.abs(ct), 2 / n);\n    const py = cy + b * Math.sign(st) * \
