   <|"Data" -> "swatchToHex[swatch_] := \n StringJoin[\"#\", \
IntegerString[Round[255 Level[RGBColor[swatch], 1]], 16, 2]]", 
    "Display" -> "codemirror", "Hash" -> 
     "06dfc29f-8645-4ef5-9a6d-085be228bcf6", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"InitGroup" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "975d27e7-ca54-4911-94b1-99bb950fc53c"|>, 
   <|"Data" -> ".wlx\n\nTimer[OptionsPattern[]] := With[{\n  event = \
CreateUUID[],\n  task = Unique[\"timer1\"],\n  startTime = \
Unique[\"timer2\"],\n  endTime = Unique[\"timer3\"],\n  color = \
OptionValue[\"Color\"],\n  period = OptionValue[\"Period\"],\n  timeout = \
QuantityMagnitude[OptionValue[\"Timeout\"], \"Seconds\"]\n},{\n  show = \
Function[time, TimerClass[\n    time,\n    \
FrontSlidesSelected[\"getRevealElement\", {}],\n    swatchToHex[color]\n  ] \
// FrontSubmit]\n},\n\nEventHandler[event, \n{\"Mounted\" -> Function[Null,\n \
 startTime = AbsoluteTime[];\n  endTime = AbsoluteTime[] + timeout;\n  task = \
SetInterval[If[AbsoluteTime[] > endTime, \n    TaskRemove[task];\n    \
EventRemove[event];\n    ClearAll[endTime, startTime];\n  ,\n    \
show[DateString[AbsoluteTime[] - startTime, {\"Minute\", \":\", \
\"Second\"}]]\n  ], period];\n], \"Destroy\" -> Function[Null,\n  \
TaskRemove[task];\n  EventRemove[event];\n  ClearAll[endTime, \
startTime];\n]}];\n\n<div>\n  <TimerScript/>\n  <SlideEventListener \
Id={event}/>\n</div>\n];\n\nOptions[Timer] = {\"Timeout\" -> Quantity[5, \
\"Minutes\"], \"Color\"->Gray, \"Period\" -> Quantity[1, \"Minutes\"]};", 
