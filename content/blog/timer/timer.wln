   <|"Data" -> ".wlx\nTimerScript := <script \
type=\"module\">\n\ncore['<TimerClass/>'] = async (args, env) => {\n  const \
time = await interpretate(args[0], env);\n  const dom = await \
interpretate(args[1], env);\n  const color = await interpretate(args[2], \
env);\n\n  const face = document.createElement('div');\n  face.innerText = \
time;\n  face.className = \"slide-number\";\n  face.style.position = \
'absolute';\n  face.style.left = '1rem';\n  face.style.color = color;\n  \
face.style.zIndex = 10000;\n  \n  dom.appendChild(face);\n  setTimeout(() => \
{\n    face.remove();\n  }, 5000);\n}\n\n</script>;", 
    "Display" -> "codemirror", "Hash" -> 
