   <|"Data" -> "(*GB[*){{(*VB[*)(FrontEndRef[\"9462ab33-4624-4f98-bcc9-3e29d6\
0d1311\"])(*,*)(*\"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkN\
VgEKW5qYGSUmGRvrAmkTXZM0SwvdpORkS13jVCPLFDODFENjQ0MAeUAVFA==\"*)(*]VB*)}(*||*\
),(*||*){(*VB[*)(FrontEndRef[\"f211fc50-8e2a-423f-9a49-5dbb2120a08f\"])(*,*)(\
*\"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgEKpxkZGqYlmxro\
WqQaJeqaGBmn6VommljqmqYkJRkZGhkkGlikAQCDUhWS\"*)(*]VB*)}}(*]GB*)", 
    "Display" -> "codemirror", "Hash" -> 
     "71337bd0-f2ca-4571-a473-20c179fc92c5", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "62ec207b-e884-499a-bcbc-79381cfa3d79"|>, 
   <|"Data" -> ".md\nOne can see the *wiggles* in the fourier image, which we \
should get rid of without any loss of resolution.\n\nLet's define our \
envelope generator:", "Display" -> "codemirror", 
    "Hash" -> "acbd0313-bda9-43c9-8a11-0d83a503affb", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "62ec207b-e884-499a-bcbc-79381cfa3d79"|>, 
   <|"Data" -> "One can see the *wiggles* in the fourier image, which we \
should get rid of without any loss of resolution.\n\nLet's define our \
envelope generator:", "Display" -> "markdown", 
    "Hash" -> "648c211a-9762-41e0-a557-0d80388a04c7", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "62ec207b-e884-499a-bcbc-79381cfa3d79"|>, 
   <|"Data" -> "env[offset_, \\[Sigma]_] := Function[x, If[x>=offset, Exp[- \
(*FB[*)(((x-offset))(*,*)/(*,*)(\\[Sigma]))(*]FB*)], 1.0]]", 
    "Display" -> "codemirror", "Hash" -> 
     "01b1d740-a79e-4ecd-bbc6-ad3862ee5275", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"InitGroup" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "62ec207b-e884-499a-bcbc-79381cfa3d79"|>, 
   <|"Data" -> ".md\n:::tip\nInstead of direct calculation of the envelope we \
return a pure function to speed up the calculations later. Pattern matching \
is fast, but pure functions wrapped with `Map` or `Table` can take advantage \
of just-in-time compiler.\n:::\n\nNow we apply to it to our time trace and \
perform Fourier transformation interactively", "Display" -> "codemirror", 
    "Hash" -> "42bf98ea-5400-478e-a737-32cfcb0ad777", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Hidden" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "62ec207b-e884-499a-bcbc-79381cfa3d79"|>, 
   <|"Data" -> ":::tip\nInstead of direct calculation of the envelope we \
return a pure function to speed up the calculations later. Pattern matching \
is fast, but pure functions wrapped with `Map` or `Table` can take advantage \
of just-in-time compiler.\n:::\n\nNow we apply to it to our time trace and \
perform Fourier transformation interactively", "Display" -> "markdown", 
    "Hash" -> "51421b27-5b90-49ef-a0d4-04349c52d47d", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "62ec207b-e884-499a-bcbc-79381cfa3d79"|>, 
   <|"Data" -> "Manipulate[With[\n{\n  e = env[offset, \\[Sigma]]\n},\n{\n  \
filtered = Map[Function[xy,\n      {xy[[1]], xy[[2]]  e @ xy[[1]]}\n  ], \
test],\n  envelope = Map[Function[xy,\n      {xy[[1]], 10.0 e @ xy[[1]]}\n  \
], test]\n},\n\nRow[{\n  ListLinePlot[{\n    (*BB[*)(* skip every 2nd point \
*)(*,*)(*\"1:eJxTTMoPSmNhYGAo5gcSAUX5ZZkpqSn+BSWZ+XnFaYwgCS4g4Zyfm5uaV+KUXxEM\
Uqxsbm6exgSSBPGCSnNSg9mAjOCSosy8dLBYSFFpKpoKkDkeqYkpEFXBILO1sCgJSczMQVYCAOFrJ\
EU=\"*)(*]BB*)\n    test[[;;;;2]],\n    filtered[[;;;;2]],\n    \
envelope[[;;;;2]]\n  }, PlotRange->Full]\n,\n  ListLinePlot[{\n    \
Take[Fourier[test[[All,2]]]//Abs, 500],\n    \
Take[Fourier[filtered[[All,2]]]//Abs, 500]\n  }, PlotRange->Full]\n}]\n\n], \
{{offset, 1108}, 1100, 1114, 2}, {{\\[Sigma], 0.4}, 0.2, 0.6, 0.1}, \
ContinuousAction->True, Appearance->None]", "Display" -> "codemirror", 
    "Hash" -> "6a1ba337-c9a1-4a92-bef3-61b7645d8bdb", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
