    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "750b5a6f-68db-498f-89a6-d5e9974f261d"|>, 
   <|"Data" -> "Module[{\n  ctx = ctx`Canvas2D[],\n  trail = Table[{0,0}, \
{10}],\n  frame = CreateUUID[],\n  target = {0,0},\n  state = Table[bridge // \
N, {3}]\n},\n  EventHandler[frame, Function[Null,\n    ctx`ClearRect[ctx, \
{0,0}, {500,500}];\n    drawBonds[ctx, 5 state[[1]], bonds, {1,2,19,20}, \
{500,500}];\n    drawPointer[ctx, trail, {}, {500,500}];\n    \
ctx`Dispatch[ctx];  \n\n    trail = RotateRight[trail, 1];\n    trail[[1]] = \
target;\n\n    state = processVertices[state, {1,2,19,20}, bonds];\n  ]];\n  \
\n  EventHandler[Image[ctx, \n    ImageResolution->{500,500},\n    \
Epilog->AnimationFrameListener[ctx, \"Event\"->frame]\n  ], {\n    \
\"mousemove\"->Function[xy,\n      target = {0,500} + {1,-1} xy;\n  ]}]\n]", 
    "Display" -> "codemirror", "Hash" -> 
     "cc4b9950-4750-4fd8-be0b-5819d1af0aae", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <|"Fade" -> True|>, 
    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
