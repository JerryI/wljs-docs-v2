)(*,*)(*\"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgEKJxsnm\
1gaWxjoJhklG+iamFik6FqmppnqWhiZAUUsTCyMjC0BftAVIQ==\"*)(*]VB*)", 
