    "PublicFields" -> {"Properties"}, "State" -> "Idle", "Type" -> "Input", 
    "UID" -> Null, "Notebook" -> "750b5a6f-68db-498f-89a6-d5e9974f261d"|>, 
   <|"Data" -> "Great! At least it did not collapse \|01f642 It would be \
great to see it live. For this we apply the same strategy with `Offload` \
technique", "Display" -> "markdown", 
    "Hash" -> "3796ab16-ab99-444b-8876-fde7d4d70a5d", "Invisible" -> False, 
    "MetaOnly" -> False, "Props" -> <||>, "PublicFields" -> {"Properties"}, 
    "State" -> "Idle", "Type" -> "Output", "UID" -> Null, 
    "Notebook" -> "750b5a6f-68db-498f-89a6-d5e9974f261d"|>, 
   <|"Data" -> "Module[{bridgeState, lines, points, handler},\n\n  handler = \
Function[Null, \n    bridgeState = processVertices[bridgeState, {1,2,19,20}, \
bonds];\n    lines = MapThread[{bridgeState[[1,#1]], bridgeState[[1,#2]]}&, \
bonds // Transpose];\n  ];\n\n  bridgeState = {bridge, bridge, bridge};\n  \
lines = MapThread[{bridgeState[[1,#1]], bridgeState[[1,#2]]}&, bonds // \
Transpose];\n  points = bridge;\n\n  Show[plotBridge[bridge], Graphics[{\n    \
ColorData[97][1], Point[points // Offload],\n    Line[lines // Offload],\n    \
EventHandler[AnimationFrameListener[lines // Offload], handler]\n  }]]\n]", 
    "Display" -> "codemirror", "Hash" -> 
     "1c3c5eb5-1671-4591-8ab1-39a1d303829b", "Invisible" -> False, 
