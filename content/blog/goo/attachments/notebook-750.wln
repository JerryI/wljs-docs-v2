)(*,*)(*\"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgEKp5qbJ\
KUZJVroGhoYJ+mapJoY6VqaWBjoGqSZpyQZGZsZmaeYAACBhBU/\"*)(*]VB*)", 
    "Display" -> "codemirror", "Hash" -> 
     "8781b301-253f-4116-a379-52c5b7915cee", "Invisible" -> False, 
