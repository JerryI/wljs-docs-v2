   <|"Data" -> "{points, latLon, elevation} = \
NotebookRead[NotebookStore[\"mouse-850\"]];", "Display" -> "codemirror", 
    "Hash" -> "c67eb3a4-59e8-44bd-a245-ddc7d39c1ca8", "Invisible" -> False, 
