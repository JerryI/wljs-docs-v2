   <|"Data" -> "points = SpherePoints[5000];\nlatLon = \
(*FB[*)((180)(*,*)/(*,*)(Pi))(*]FB*) {90Degree - ArcCos[#[[3]]], \
ArcTan[#[[1]], #[[2]]]} &/@ points;\nelevation = \
GeoElevationData[GeoPosition[latLon]];\nelevation = (elevation + \
Min[elevation])/Max[elevation];", "Display" -> "codemirror", 
    "Hash" -> "97e1f2b8-bc0b-4b34-8340-76340f97468c", "Invisible" -> False, 
