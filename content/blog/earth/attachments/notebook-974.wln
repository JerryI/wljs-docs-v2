elevation}], \n  Mesh->None, MaxPlotPoints->50, \n  ColorFunction -> \
Function[{x,y,z}, rainbow[1.5(2 Norm[{x,y,z}]-1)]], \n  ColorFunctionScaling \
-> False, \n  Lighting->\"Default\",\n  \
