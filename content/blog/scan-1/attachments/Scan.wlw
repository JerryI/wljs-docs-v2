%-------------------------------------------------------------------------%
Reject frame-border lines and require one candidate in each outer half of the photograph

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
xmid[l_] := Mean[l[[All, 1]]];
ymid[l_] := Mean[l[[All, 2]]];

leftPool = Select[
      vertical,
      0.02 w < xmid[#] < 0.48 w &
];
rightPool = Select[
      vertical,
      0.52 w < xmid[#] < 0.98 w &
];
bottomPool = Select[
      horizontal,
      0.02 h < ymid[#] < 0.48 h &
];
topPool = Select[
      horizontal,
      0.52 h < ymid[#] < 0.98 h &
];

%-------------------------------------------------------------------------%
