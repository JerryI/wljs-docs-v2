We can try to locate 4 corners of the image

%-------------------------------------------------------------------------%
Display: markdown
Type: Output
%-------------------------------------------------------------------------%
We can try to locate 4 corners of the image

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
find4Corners[pts_] := {
  First @ MaximalBy[pts, -#[[1]] + #[[2]] &], (* 1st: Top-Left *)
  First @ MaximalBy[pts,  #[[1]] + #[[2]] &], (* 2nd: Top-Right *)
  First @ MaximalBy[pts,  #[[1]] - #[[2]] &], (* 3rd: Bottom-Right *)
  First @ MinimalBy[pts,  #[[1]] + #[[2]] &]  (* 4th: Bottom-Left *)
};
corners = find4Corners@PixelValuePositions[ColorConvert[cropped, "Gray"] // EdgeDetect , 1];
HighlightImage[cropped, {Yellow, Line[Append[corners, corners[[1]]]], Opacity[0.3], Disk[corners, Offset[{20,20}]]}]

%-------------------------------------------------------------------------%
Type: Output
%-------------------------------------------------------------------------%
(*VB[*)(FrontEndRef["a4aa8caf-11c4-44c9-914b-7df213b09e23"])(*,*)(*"1:eJxTTMoPSmNkYGAoZgESHvk5KRCeEJBwK8rPK3HNS3GtSE0uLUlMykkNVgEKJ5okJlokJ6bpGhomm+iamCRb6loamiTpmqekGRkaJxlYphoZAwCOzRXF"*)(*]VB*)

