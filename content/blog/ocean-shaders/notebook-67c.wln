let THREE;

core.MeshMod2 = async (args, env) => {
  if (!THREE) {
    await interpretate.shared.THREE.load()
    THREE = interpretate.shared.THREE.THREE;
  }

  return function() {
    return new THREE.ShaderMaterial({
        name: 'MeshMod2',
        uniforms: {},
        vertexShader: `
          void main() {
            vec3 dir = vec3(1.0,1.0,0.0);
            float a = 0.5;
            float alpha = 3.0;
            vec3 m = a * sin(alpha * dot(position, dir)) * normalize(normal);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position + m, 1.0);
          }
        `,      
        fragmentShader: `
          void main() {
            gl_FragColor = vec4(1.0, 0.77, 0.34, 1.0);
          }
        `,
        lights: false,
        toneMapped: false
      });    
  }
}

