.js
let THREE;

core.MeshMod4 = async (args, env) => {
  if (!THREE) {
    await interpretate.shared.THREE.load()
    THREE = interpretate.shared.THREE.THREE;
  }

  return function() {
    const material = new THREE.ShaderMaterial({
        name: 'MeshMod4',
        uniforms: {
          time: { value: 0.0 }
        },
        vertexShader: `
          varying vec3 vNormals; 
          uniform float time; // Seconds since this material was created.
          
          void main() {
            vec3 dir = vec3(1.0,1.0,0.0);
            float speed = 2.0;
            float a = 0.1;
            float alpha = 5.0;
            // Two harmonics share the same travelling phase.
            vec3 m = a * (sin(time*speed + alpha * dot(position, dir)) + sin(2.0*time*speed + 2.0*alpha * dot(position, dir)))  * normalize(normal);
            // Intermediate version: lighting still uses the undeformed normal.
            vNormals = normalize(normalMatrix * normal);
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position + m, 1.0);
          }
        `,      
        fragmentShader: `
          varying vec3 vNormals;
          
          void main() {
            vec3 n = normalize(vNormals);
            vec3 lightDir = normalize(vec3(1.0, 0.8, 1.0));
            vec3 viewDir = vec3(0.0, 0.0, 1.0);

            vec3 deepWater = vec3(0.2, 0.22, 0.45);
            vec3 shallowWater = vec3(0.10, 0.65, 0.80);
            float diffuse = clamp(dot(n, lightDir), 0.0, 1.0);
            vec3 waterColor = mix(deepWater, shallowWater, diffuse);

            vec3 halfVector = normalize(lightDir + viewDir);
            float spec = pow(max(dot(n, halfVector), 0.0), 64.0);
            vec3 specular = vec3(1.0) * spec * 0.85;

            float fresnel = pow(1.0 - max(dot(n, viewDir), 0.0), 3.0);
            vec3 skyColor = vec3(0.70, 0.88, 0.98);

            // Combine water color, sky reflection, and sun glint
            vec3 finalColor = mix(waterColor, skyColor, fresnel * 0.55) + specular;
            gl_FragColor = vec4(finalColor, 1.0); 
          }
        `,
        lights: false,
        toneMapped: false
      }); 
  
    const start = performance.now();
    material.onBeforeRender = () => {
      material.uniforms.time.value = (performance.now() - start) / 1000;
    };

    return material;
  }
}

