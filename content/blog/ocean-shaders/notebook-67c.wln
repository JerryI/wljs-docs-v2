troke-width="2" fill="none"></path></g></svg></div>


In the contrast the fragment shader won't receive such slice, but it can get the interpolated per-pixel data generated by vertex shader (if needed).

:::help
See the [ShaderMaterial documentation](https://threejs.org/docs/pages/ShaderMaterial.html) for that interface.
:::

We only have to write the new position and the output color. 

%-------------------------------------------------------------------------%
Type: Input
%-------------------------------------------------------------------------%
.js
let THREE;

core.MeshMod1 = async (args, env) => {
  if (!THREE) {
    await interpretate.shared.THREE.load()
    THREE = interpretate.shared.THREE.THREE;
  }

  return function() {
    return new THREE.ShaderMaterial({
        name: 'MeshMod1',
        uniforms: {},
        vertexShader: `
          void main() {
            vec3 n = normalize(normal);
            float a = 0.5;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position + a * n, 1.0);
          }
        `,      
        fragmentShader: `
          void main() {
            gl_FragColor = vec4(1.0, 0.77, 0.34, 1.0);
          }
        `,
        lights: false,
        toneMapped: false
      });    
  }
}

%-------------------------------------------------------------------------%
Display: js
Type: Output
%-------------------------------------------------------------------------%
let THREE;

core.MeshMod1 = async (args, env) => {
  if (!THREE) {
    await interpretate.shared.THREE.load()
    THREE = interpretate.shared.THREE.THREE;
  }

  return function() {
    return new THREE.ShaderMaterial({
        name: 'MeshMod1',
        uniforms: {},
        vertexShader: `
          void main() {
            vec3 n = normalize(normal);
            float a = 0.5;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position + a * n, 1.0);
          }
        `,      
        fragmentShader: `
          void main() {
            gl_FragColor = vec4(1.0, 0.77, 0.34, 1.0);
          }
        `,
        lights: false,
        toneMapped: false
      });    
  }
}

