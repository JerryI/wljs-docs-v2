{
  "name": "wljs-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=9096' next build && node ./scripts/sync-content.ts",
    "dev": "NODE_OPTIONS='--max-old-space-size=9096' next dev",
    "start": "NODE_OPTIONS='--max-old-space-size=9096' next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@vercel/speed-insights": "^1.3.1",
    "algoliasearch": "^5.46.2",
    "fumadocs-core": "16.3.2",
    "fumadocs-mdx": "14.2.2",
    "fumadocs-obsidian": "^0.0.6",
    "fumadocs-ui": "16.3.2",
    "katex": "^0.16.27",
    "lucide-react": "^0.561.0",
    "next": "16.0.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
